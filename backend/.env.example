# development | test | production
ENV=development
DATABASE_URL=postgresql+asyncpg://langcoach:langcoach@localhost:5432/langcoach

# Ed25519 private key (PEM) for access tokens. Generate:
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey as K; from cryptography.hazmat.primitives import serialization as s; print(K.generate().private_bytes(s.Encoding.PEM, s.PrivateFormat.PKCS8, s.NoEncryption()).decode())"
# Leave empty in development to use an ephemeral key (sessions reset on restart).
JWT_PRIVATE_KEY_PEM=

APPLE_TEAM_ID=TEAMID1234
APPLE_BUNDLE_ID=com.example.langcoach

# enforce | report | off   (off is refused when ENV=production; the Simulator can't attest)
APP_ATTEST_MODE=report

# fake | openai_compatible | anthropic
LLM_PROVIDER=openai_compatible
# Hearth / vLLM / llama.cpp / Ollama OpenAI-compatible endpoint (not :8000 — that's this backend)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed-for-local
LLM_FAST_MODEL=qwen3-27b
LLM_SMART_MODEL=qwen3-27b
# For LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
