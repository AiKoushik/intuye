# Local development settings. The run scripts copy this to backend/.env on first run; edit .env, not this.
ENV=development
DATABASE_URL=sqlite+aiosqlite:///./intuye-dev.db

# Local testing: no App Attest (browsers and the Simulator can't attest) and test sign-in for the web build.
APP_ATTEST_MODE=off
DEV_LOGIN_ENABLED=true
# Generous limits so quick clicking through the web build isn't throttled.
RATE_LIMIT_PER_MINUTE=600
COACH_RATE_LIMIT_PER_MINUTE=120

# Model behind every agent (LangChain Deep Agents; the model needs tool calling):
#   fake              tiny offline dictionary; fine for clicking through the UI, not for real Spanish
#   openai_compatible your own server (Hearth, Ollama, vLLM, llama.cpp); set LLM_BASE_URL and model names
#   anthropic         Claude via ANTHROPIC_API_KEY
# The run scripts' -Model / --model flag overrides this per run.
LLM_PROVIDER=fake
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed-for-local
LLM_FAST_MODEL=qwen3:32b
LLM_SMART_MODEL=qwen3:32b
ANTHROPIC_API_KEY=

# Scene library search and de-duplication:
#   hash              hashed word + character n-grams; offline, keyword-like (default for dev and tests)
#   openai_compatible /v1/embeddings on EMBED_BASE_URL (empty = LLM_BASE_URL), e.g. `ollama pull bge-m3`
EMBED_PROVIDER=hash
EMBED_MODEL=bge-m3
EMBED_BASE_URL=
LIBRARY_SIMILAR_THRESHOLD=0.82

APPLE_TEAM_ID=TEAMID1234
APPLE_BUNDLE_ID=com.example.intuye
